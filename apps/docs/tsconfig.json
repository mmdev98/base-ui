{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "noUncheckedIndexedAccess": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@logic-ui/react": ["../../packages/react/src"],
      "@logic-ui/react/*": ["../../packages/react/src/*"]
    }
  },
  "include": [
    "src",
    "next-env.d.ts",
    "next.config.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "export"]
}
